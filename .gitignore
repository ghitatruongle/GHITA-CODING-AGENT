# Dependencies
node_modules/
.pnp
.pnp.js
.pnp.cjs
.pnp.mjs

# Build output
dist/
build/
target/
out/
.next/
*.tsbuildinfo
apps/desktop/src-tauri/sidecar/server.bundle.mjs
apps/desktop/src-tauri/sidecar/node.exe

# Android / native build caches
apps/mobile/android/.gradle/
apps/mobile/android/app/.cxx/
apps/mobile/android/app/build/
apps/mobile/android/build/
apps/mobile/android/.kotlin/

# Rust / Tauri
apps/desktop/src-tauri/target/

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test
coverage/
.nyc_output/

# Turbo
.turbo/

# OpenClaude config
.openclaude/

# Refer projects (cloned repos - too large for main repo, local only)
refer_project/

# Local scripts (temp files only, NOT the directory itself)
scripts/*.tmp
scripts/*.log

# OS
.DS_Store
Thumbs.db
desktop.ini

# Plan
Plan/

# Generated TypeDoc API docs (auto-generated from source)
docs/docs/api/

# Agent handoff documents (internal, not for git)
agents/**/handoff.md

# Internal planning docs (not for git)
docs/superpowers/
.agents/
.kimchi/
progress.md
PROJECT.md
TEST_INFRA.md

# Internal scripts
scripts/clone-refer.sh
scripts/inspect_*.py
scripts/verify_doc.py
scripts/sync_m1_doc.py

# Test data
tests/quality-loop/trends.jsonl
tests/benchmark/history.jsonl
tests/benchmark/results.json
test-ledger.sqlite

# Python scratch/fix scripts
*.py

# Root debug images / temp files
/*.png
window_dump.xml
test_write.tmp

# Compiled output in source dirs (should only exist in dist/)
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts.map

# Temp analysis files from commands
untracked_*.txt
%TEMP%*.txt

# Build logs
build_output.txt

# Windows null device artifact
nul

# Debug keystores
apps/mobile/android/app/debug.keystore

# Build artifacts
apps/mobile/android/app/src/main/assets/index.android.bundle

