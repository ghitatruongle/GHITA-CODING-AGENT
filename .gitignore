# ==============================================================================
# GHITA CODING AGENT - Master .gitignore
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# 1. SECURITY, SECRETS & KEYS (CRITICAL FOR OPEN-SOURCE RELEASE)
# ──────────────────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env
*.pem
*.key
*.p12
*.pfx
*.asc
*.crt
*.cer
*.keystore
*.jks
*.mobileprovision
secrets.json
credentials.json

# ──────────────────────────────────────────────────────────────────────────────
# 2. MONOREPO & NODE DEPENDENCIES
# ──────────────────────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.pnp.cjs
.pnp.mjs
.pnpm-store/
.turbo/
packages/*/.turbo/
apps/*/.turbo/
docs/.turbo/

# ──────────────────────────────────────────────────────────────────────────────
# 3. BUILD OUTPUTS & COMPILATION ARTIFACTS
# ──────────────────────────────────────────────────────────────────────────────
dist/
build/
out/
target/
.next/
*.tsbuildinfo
*.vsix
packages/*/dist/
apps/*/dist/
docs/.docusaurus/
docs/docs/api/

# Compiled JS/D.TS inside TS source directories
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts.map

# Native C / C++ / Rust Object Files & Binaries
*.o
*.obj
*.dll
*.so
*.dylib
*.exe
*.lib
*.a
*.exp
*.pdb
*.ilk

# ──────────────────────────────────────────────────────────────────────────────
# 4. TAURI & RUST (DESKTOP APP)
# ──────────────────────────────────────────────────────────────────────────────
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/sidecar/server.bundle.mjs
apps/desktop/src-tauri/sidecar/node.exe
apps/desktop/src-tauri/sidecar/meta.json
# Tauri CLI regenerates these ACL/schema files on every build — not source
apps/desktop/src-tauri/gen/schemas/

# Pre-built installer artifacts (produced by scripts/build-installer.mjs).
# Installers are released via GitHub Releases, not committed to the repo.
/release/

# ──────────────────────────────────────────────────────────────────────────────
# 5. MOBILE CLIENTS (ANDROID & IOS)
# ──────────────────────────────────────────────────────────────────────────────
# Android
apps/mobile/android/.gradle/
apps/mobile/android/app/.cxx/
apps/mobile/android/app/build/
apps/mobile/android/build/
apps/mobile/android/.kotlin/
apps/mobile/android/local.properties
apps/mobile/android/captures/
apps/mobile/android/app/debug.keystore
apps/mobile/android/app/src/main/assets/index.android.bundle
*.apk
*.aab
*.dex
*.class

# iOS
apps/mobile/ios/Pods/
apps/mobile/ios/build/
apps/mobile/ios/DerivedData/
apps/mobile/ios/*.xcworkspace
apps/mobile/ios/*.xcodeproj/project.xcworkspace
apps/mobile/ios/*.xcodeproj/xcuserdata

# Metro & Bundler Caches
.metro-health-check*

# ──────────────────────────────────────────────────────────────────────────────
# 6. PYTHON & VIRTUAL ENVS
# ──────────────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/
ENV/

# ──────────────────────────────────────────────────────────────────────────────
# 7. TESTING, LOGS & DIAGNOSTICS
# ──────────────────────────────────────────────────────────────────────────────
coverage/
.nyc_output/
packages/*/coverage/
apps/*/coverage/
test-results/
playwright-report/
blob-report/
.vscode-test/
*.sqlite
**/test-ledger.sqlite
test-ledger.sqlite

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
debug.log
test-output.log
typedoc_error.log
build_output.txt

# ──────────────────────────────────────────────────────────────────────────────
# 8. OS & IDE ARTIFACTS
# ──────────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
*.orig
*.rej
/nul
nul

# IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ──────────────────────────────────────────────────────────────────────────────
# 9. LOCAL AGENT WORKSPACES & REFER PROJECTS (LOCAL ONLY)
# ──────────────────────────────────────────────────────────────────────────────
refer_project/
.openclaude/
.agents/
.kimchi/
.zcode/
Plan/
agents/**/handoff.md

# Internal & Temp Scripts
scripts/*.tmp
scripts/*.log
scripts/clone-refer.sh
scripts/inspect_*.py
scripts/verify_doc.py
scripts/sync_m1_doc.py
untracked_*.txt
%TEMP%*.txt
window_dump.xml
test_write.tmp
/*.png

# Test data & benchmarks
tests/quality-loop/trends.jsonl
tests/benchmark/history.jsonl
tests/benchmark/results.json

# ──────────────────────────────────────────────────────────────────────────────
# 10. ADDITIONAL BUILD ARTIFACTS & CACHES (v1.0.0 final pass)
# ──────────────────────────────────────────────────────────────────────────────

# Native addons (NAPI/Rust) — platform-specific binaries, rebuilt per OS.
# Source lives alongside (e.g. packages/memory/src/semantic/rust/), never
# commit the compiled binary.
*.node

# Frontend tooling caches
.eslintcache
.cache/
.vite/
.parcel-cache/

# Android — assets auto-copied from node_modules by asset linking during
# builds (name pattern `__node_modules_pnpm_*`). Regenerated on build.
apps/mobile/android/app/src/main/res/**/__node_modules_pnpm_*

# Husky v9 hooks runtime (installed by `prepare` script)
.husky/_

# Local-only overrides (e.g. settings.local.json, vite.config.local.ts)
*.local

# Editor per-project state that should never be shared
.zed/
cursor/

