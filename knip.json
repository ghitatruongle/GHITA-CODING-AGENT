{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/**/*.mjs", "vitest.workspace.ts"],
  "project": ["**/*.ts", "**/*.tsx", "**/*.mjs"],
  "ignoreDependencies": [
    "@types/node",
    "typescript",
    "vitest",
    "@vitest/coverage-v8",
    "esbuild",
    "tsx",
    "@react-native/babel-preset",
    "@react-native/gradle-plugin",
    "@react-native/community-cli-plugin",
    "@napi-rs/cli",
    "@babel/runtime",
    "@ghita/ai-engine",
    "@ghita/browser-control",
    "@ghita/communication",
    "@ghita/computer-use",
    "@ghita/memory",
    "@ghita/shared",
    "socket.io"
  ],
  "ignoreBinaries": ["stryker", "cargo", "AGPL-3.0", "SSPL"],
  "rules": {
    "files": "off",
    "devDependencies": "warn",
    "duplicates": "warn",
    "nsExports": "off",
    "nsTypes": "off",
    "unlisted": "warn"
  }
}
