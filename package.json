{
  "name": "ghita-coding-agent",
  "version": "0.0.2-beta1",
  "private": true,
  "description": "GHITA CODING AGENT - Desktop AI Agent với multi-provider, skills, computer use",
  "author": "ghitatruongle",
  "license": "MIT",
  "scripts": {
    "dev": "turbo dev",
    "dev:desktop": "pnpm --filter @ghita/desktop tauri dev",
    "build:desktop": "pnpm --filter @ghita/desktop tauri build",
    "dev:android": "pnpm --filter @ghita/mobile android",
    "build:android": "pnpm --filter @ghita/mobile build:release",
    "build": "turbo build",
    "build:packages": "turbo build --filter='./packages/*'",
    "lint": "turbo lint",
    "lint:fix": "turbo lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean",
    "clean:all": "turbo clean && rm -rf node_modules && rm -rf packages/*/node_modules && rm -rf apps/*/node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "playwright": "^1.60.0",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.4.0",
    "sharp": "^0.34.5",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@nut-tree/nut-js": "npm:@nut-tree-fork/nut-js@^4.2.6"
  }
}
