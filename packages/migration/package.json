{
  "name": "@ghita/migration",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "description": "Migration tools: import/export, version migration, backup/restore",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.readdirSync('.').filter(f=>f.endsWith('.tsbuildinfo')).forEach(f=>fs.rmSync(f,{force:true}))\""
  },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.6.0" }
}
