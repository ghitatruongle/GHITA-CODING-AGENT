{
  "name": "@ghita/integration",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "description": "Final integration: cross-module smoke tests, performance regression, security pen test",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.readdirSync('.').filter(f=>f.endsWith('.tsbuildinfo')).forEach(f=>fs.rmSync(f,{force:true}))\""
  },
  "devDependencies": { "typescript": "^5.6.0" }
}
