{
  "name": "@ghita/skills",
  "version": "0.1.0",
  "private": true,
  "description": "Skill system cho GHITA CODING AGENT",
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./marketplace/*": {
      "types": "./dist/marketplace/*.d.ts",
      "import": "./dist/marketplace/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@ghita/shared": "workspace:*",
    "@ghita/agents": "workspace:*",
    "@ghita/ai-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^3.1.0"
  }
}
