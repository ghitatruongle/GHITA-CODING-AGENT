{
  "name": "@ghita/ai-engine",
  "version": "0.1.0",
  "private": true,
  "description": "AI multi-provider engine cho GHITA CODING AGENT",
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node copy-proto.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_OPTIONS='--experimental-vm-modules' vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ghita/shared": "workspace:*",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
