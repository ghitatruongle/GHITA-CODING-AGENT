<?xml version="1.0" encoding="utf-8"?>
<!--
  GHITA CODING AGENT — Network Security Config

  Cleartext (HTTP) is ONLY allowed for RFC1918 private LAN addresses used by the
  desktop sidecar (Socket.IO + health check on port 8080). All public traffic —
  including the cloud relay (onrender.com) — MUST use HTTPS.

  Android <domain> does not support wildcards or CIDR notation, so we trust the
  three private ranges by their network addresses. Pairing always targets a user-
  entered LAN IP (e.g. 192.168.1.x), which Android accepts under these rules.

  TODO(Phase 5): replace cleartext entirely with a self-signed cert generated by
  the desktop sidecar and pinned via trust-anchors during pairing.
-->
<network-security-config>
    <!-- Default: deny all cleartext (HTTPS only) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Private LAN ranges used for desktop pairing (HTTP on port 8080) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.0.0</domain>
        <domain includeSubdomains="false">172.16.0.0</domain>
        <domain includeSubdomains="false">192.168.0.0</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
