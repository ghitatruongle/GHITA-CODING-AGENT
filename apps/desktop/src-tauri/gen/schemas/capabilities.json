{
  "default": {
    "identifier": "default",
    "description": "Default capabilities for GHITA CODING AGENT",
    "local": true,
    "windows": ["main", "splash"],
    "permissions": [
      "core:default",
      "updater:default",
      "dialog:allow-open",
      "fs:allow-read-file",
      "fs:allow-write-file",
      "fs:allow-exists",
      "fs:allow-read-dir",
      "fs:allow-mkdir",
      "fs:allow-remove",
      "fs:allow-rename",
      "fs:allow-app-read",
      "fs:allow-app-write",
      {
        "identifier": "fs:scope",
        "allow": [
          { "path": "$APPDATA/ghita/**" },
          { "path": "$DOCUMENT/ghita-workspace/**" },
          { "path": "$DOCUMENT/**" },
          { "path": "$DESKTOP/**" },
          { "path": "$DOWNLOAD/**" }
        ]
      }
    ]
  }
}
