{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "GHITA CODING AGENT",
  "version": "0.8.0",
  "identifier": "com.ghita.coding-agent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "GHITA CODING AGENT",
        "label": "main",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": true,
        "visible": false
      },
      {
        "label": "splash",
        "url": "splash.html",
        "width": 400,
        "height": 320,
        "decorations": false,
        "transparent": true,
        "center": true,
        "resizable": false,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' asset:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https://api.openai.com https://api.anthropic.com https://generativelanguage.googleapis.com https://*.onrender.com https://avatars.githubusercontent.com https://www.google.com/s2/favicons; connect-src 'self' ipc: http://localhost:* http://127.0.0.1:* ws://127.0.0.1:* ws://localhost:* https://api.openai.com https://api.anthropic.com https://generativelanguage.googleapis.com https://*.onrender.com; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'; frame-src 'self' http://localhost:* http://127.0.0.1:*; worker-src 'self' blob: data:; media-src 'self' blob:; form-action 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": ["sidecar/*", "proto/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Vietnamese"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ghitatruongle/GHITA-CODING-AGENT/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1N0E2RTdGMkQ0MUI5MDgKUldTY09EVmRZV3hzYmxSdllrWnFZMkZ6Y3k5amIyOTFjMkZ1Wkc5M2VYSmhkR2x2Ymw5amEyVnkK"
    }
  }
}
